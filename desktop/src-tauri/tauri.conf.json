{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoynixScribe",
  "version": "2.4.0",
  "identifier": "com.joynix.joynixscribe",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JoynixScribe",
        "width": 980,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Joynix",
    "copyright": "© 2026 Joynix",
    "shortDescription": "Dictée vocale IA pour Windows",
    "longDescription": "JoynixScribe transcrit votre voix en texte avec Gemini, Groq, Cloudflare Workers AI ou Aperture, puis l'insère dans n'importe quelle application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
