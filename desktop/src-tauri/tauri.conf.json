{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoynixScribe",
  "version": "2.2.0",
  "identifier": "com.joynix.joynixscribe",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "JoynixScribe",
        "width": 520,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": []
  }
}
